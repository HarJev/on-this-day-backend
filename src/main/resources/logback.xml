<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%level logger=%logger{36} %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.onthisday" level="INFO" />

  <root level="WARN">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
